{
  "name": "imagie-creation-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "validate": "node scripts/validate.mjs",
    "prebuild": "node scripts/check-required-files.mjs && node scripts/generate-seo.mjs && node scripts/generate-product-images.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "check:catalog": "node scripts/sync-catalog.mjs --check",
    "photos": "node scripts/generate-product-images.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "check": "npm run validate && npm test"
  },
  "devDependencies": {
    "vite": "^7.0.0",
    "@capacitor/cli": "^7.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@supabase/supabase-js": "^2.49.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
