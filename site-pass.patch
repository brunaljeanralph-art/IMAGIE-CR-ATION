+// Runs before `vite build`. Needs SITE_URL (e.g. https://www.votre-domaine.com), set in Vercel.
+// Without SITE_URL: robots.txt is written without a Sitemap line and no sitemap.xml is produced.
+import { writeFile, rm } from 'node:fs/promises';
+import { resolve, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const pub = resolve(dirname(fileURLToPath(import.meta.url)), '../public');
+const raw = (process.env.SITE_URL || '').trim().replace(/\/+$/, '');
+const pages = ['', 'boutique.html', 'metiers.html', 'offres.html', 'a-propos.html', 'contact.html', 'confidentialite.html', 'conditions.html', 'livraison.html'];
+let robots = 'User-agent: *\nAllow: /\nDisallow: /admin.html\nDisallow: /compte.html\nDisallow: /suivi.html\nDisallow: /connexion.html\nDisallow: /inscription.html\nDisallow: /mot-de-passe-oublie.html\nDisallow: /completer-profil.html\n';
+if (/^https:\/\/[a-z0-9.-]+$/i.test(raw)) {
+  robots += `Sitemap: ${raw}/sitemap.xml\n`;
+  const urls = pages.map((p) => `  <url><loc>${raw}/${p}</loc></url>`).join('\n');
+  await writeFile(resolve(pub, 'sitemap.xml'), `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n${urls}\n</urlset>\n`);
+  console.log(`SEO: sitemap.xml + robots.txt générés pour ${raw}`);
+} else {
+  await rm(resolve(pub, 'sitemap.xml'), { force: true });
+  console.warn('SEO: SITE_URL absent ou invalide (https://... attendu) — pas de sitemap.xml.');
+}
+await writeFile(resolve(pub, 'robots.txt'), robots);
diff -ruN '--exclude=node_modules' '--exclude=last-*.json' /home/claude/up/final/IMAGIE_CREATION_FINAL/site/scripts/sync-catalog.mjs IMAGIE_CREATION_FINAL/site/scripts/sync-catalog.mjs
--- /home/claude/up/final/IMAGIE_CREATION_FINAL/site/scripts/sync-catalog.mjs	1970-01-01 00:00:00.000000000 +0000
+++ IMAGIE_CREATION_FINAL/site/scripts/sync-catalog.mjs	2026-11-21 07:32:33.874758059 +0000
@@ -0,0 +1,30 @@
+// Single source of truth: ../src/data/catalog-seed.json
+// `npm run sync:catalog`   -> copies it to site/data and site/public/data
+// `npm run check:catalog`  -> fails if the three copies differ
+import { readFile, writeFile, mkdir } from 'node:fs/promises';
+import { resolve, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const site = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const canonical = resolve(site, '../src/data/catalog-seed.json');
+const targets = [resolve(site, 'data/catalog.json'), resolve(site, 'public/data/catalog.json')];
+const check = process.argv.includes('--check');
+
+const source = await readFile(canonical, 'utf8');
+const parsed = JSON.parse(source);
+const skus = parsed.products.map((p) => p.sku);
+const dupes = skus.filter((s, i) => skus.indexOf(s) !== i);
+if (dupes.length) { console.error(`SKU dupliqués: ${[...new Set(dupes)].join(', ')}`); process.exit(1); }
+
+let bad = 0;
+for (const target of targets) {
+  let current = null;
+  try { current = await readFile(target, 'utf8'); } catch { /* missing */ }
+  if (current === source) continue;
+  if (check) { console.error(`DIFFÉRENT: ${target}`); bad++; continue; }
+  await mkdir(dirname(target), { recursive: true });
+  await writeFile(target, source);
+  console.log(`Synchronisé: ${target}`);
+}
+if (bad) { console.error('Exécutez: npm run sync:catalog'); process.exit(1); }
+console.log(`Catalogue cohérent: ${parsed.products.length} familles, ${targets.length + 1} fichiers identiques.`);
